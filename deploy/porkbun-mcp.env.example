# /etc/porkbun-mcp.env — read by the systemd unit. No secrets belong here:
# the hosted connector authenticates every request with the caller's own OAuth
# token and holds no credentials of its own.

# Listen on every interface; the security group allows 8787 from the ALB only.
HOST=0.0.0.0
PORT=8787

# Must match the URL users add in ChatGPT / Claude EXACTLY (scheme + host). The
# protected-resource metadata advertises "$MCP_PUBLIC_URL/mcp" as the resource,
# and Claude compares it character for character.
MCP_PUBLIC_URL=https://mcp.porkbun.com

# The OAuth authorization server (porkbun.com/oauth2/*).
OAUTH_ISSUER=https://porkbun.com

# Where tool calls go.
PORKBUN_BASE_URL=https://api.porkbun.com/api/json/v3
PORKBUN_DOCS_BASE=https://porkbun.com

NODE_ENV=production

{
  "name": "@porkbunllc/mcp-server",
  "version": "0.35.0",
  "description": "Official Porkbun MCP server, built and maintained by Porkbun \u2014 exposes the Porkbun v3 API as tools for AI agents (ChatGPT, Claude, Cursor, etc.)",
  "author": "Porkbun LLC <support@porkbun.com> (https://porkbun.com)",
  "type": "module",
  "bin": {
    "porkbun-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "rm -rf dist && tsc",
    "start:http": "node dist/http.js"
  },
  "keywords": [
    "mcp",
    "porkbun",
    "domain",
    "dns",
    "ai",
    "agent",
    "claude"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oborseth/Porkbun-MCP.git"
  },
  "bugs": {
    "url": "https://github.com/oborseth/Porkbun-MCP/issues"
  },
  "homepage": "https://porkbun.com/mcp",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.1",
    "typescript": "^6.0.3"
  }
}
